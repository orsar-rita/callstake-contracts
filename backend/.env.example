# Copy to .env and fill in for local development.
# `docker-compose up` (see docker-compose.yml) provides Postgres/Redis that
# match the defaults below without changing anything here.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=callstake
DATABASE_PASSWORD=callstake
DATABASE_NAME=callstake
DATABASE_SSL=false

# Redis (auth challenges, response cache, BullMQ queues)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT — must be at least 16 characters. Generate a real secret for anything
# beyond local dev; this is not a usable default.
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_ISSUER=callstake-backend
JWT_EXPIRES_IN=1h
AUTH_CHALLENGE_TTL_SECONDS=300

# Which network's deployment metadata (deployments/registry.json,
# config/<network>.json) the backend resolves contract addresses against.
STELLAR_NETWORK=testnet

# A funded account used only to build/simulate read-only contract calls —
# required for any GET endpoint under /contracts/*. Soroban needs a real
# source account to construct a transaction envelope even for a call that
# charges no fee; this account is never used to sign anything. Generate one
# with the Stellar CLI (`stellar keys generate`) and fund it via
# https://friendbot.stellar.org on testnet.
# SOROBAN_SIMULATION_ACCOUNT=

# Manual override for the real user_portfolio crate's address — not
# resolvable through deployments/registry.json today (see
# ContractRegistryService's doc comment). Required for
# /contracts/user-portfolio/* endpoints.
# USER_PORTFOLIO_CONTRACT_ADDRESS=
