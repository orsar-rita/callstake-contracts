# Copy to .env and fill in for local development.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# JWT — must be at least 16 characters. Generate a real secret for anything
# beyond local dev; this is not a usable default.
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_ISSUER=callstake-backend
JWT_EXPIRES_IN=1h
AUTH_CHALLENGE_TTL_SECONDS=300

# Which network's deployment metadata (deployments/registry.json,
# config/<network>.json) the backend resolves contract addresses against.
STELLAR_NETWORK=testnet
